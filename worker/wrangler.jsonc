{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nujoom",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-16",
	"compatibility_flags": ["nodejs_compat"],

	// الواجهة الأمامية تُقدَّم كـ static assets مباشرة من مجلد frontend/
	// run_worker_first: المسارات التي يجب أن يراها الـ Worker قبل الملفات الثابتة.
	//   /api/*      → الـ API
	//   /admin.html → بوابة مفتاح الأدمين (وإلا لخُدّم الملف للجميع)
	//   /           → إعادة توجيه للصفحة الرئيسية home.html
	// html_handling: "none" مهمّ — الافتراضي يعيد توجيه /login.html إلى /login (307)
	// وكل روابط الموقع مكتوبة بامتداد .html صراحةً، فكان ذلك يكسر التنقل كلياً.
	"assets": {
		"directory": "../frontend",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": ["/api/*", "/admin.html", "/health", "/"]
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nujoom-db",
			"database_id": "a2d02637-939d-44f7-b76e-df7c396dc382",
			"migrations_dir": "migrations"
		}
	],

	// بديل express-rate-limit: مخزنه كان في ذاكرة العملية، وعلى Workers كل عزلة
	// لها ذاكرتها فالعدّاد يُصفَّر باستمرار. هذا الربط يعدّ على مستوى الشبكة.
	// ملاحظة: period يقبل 10 أو 60 ثانية فقط، لذا حوّلنا "15 محاولة/15 دقيقة"
	// إلى حد لكل دقيقة — حماية أقرب للانفجارات القصيرة وهي الحالة المهمة هنا.
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "AI_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 15, "period": 60 }
		}
	],

	"observability": {
		"enabled": true
	}
}
